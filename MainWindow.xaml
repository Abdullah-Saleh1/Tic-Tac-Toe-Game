<Window x:Class="Tic_Tac_Toe_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Infinite Tic Tac Toe" Height="650" Width="450"
        WindowStartupLocation="CenterScreen" Background="#121212"
        ResizeMode="NoResize" Icon="/Resources/Free Palestine Image.png">

    <Window.Resources>
        <Style x:Key="SimpleHoverButton" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FF1C97EA"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FF005999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="INFINITE TIC-TAC-TOE" 
                   HorizontalAlignment="Center" Foreground="#FF007ACC" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Background="#1E1E1E" Padding="15,8" CornerRadius="8" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Turn: " Foreground="#888888" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblTurn" Text="Player 1: X" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#1E1E1E" Padding="15,8" CornerRadius="8" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " Foreground="#888888" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblWinner" Text="In Progress" Foreground="#FF23FF00" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="15" Padding="15" VerticalAlignment="Center">
            <Grid x:Name="GameBoard">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="5" Width="6" Background="#2D2D30" CornerRadius="3"/>
                <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="5" Width="6" Background="#2D2D30" CornerRadius="3"/>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="6" Background="#2D2D30" CornerRadius="3"/>
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Height="6" Background="#2D2D30" CornerRadius="3"/>

                <Border x:Name="pb1" Grid.Row="0" Grid.Column="0" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img1" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb2" Grid.Row="0" Grid.Column="2" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img2" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb3" Grid.Row="0" Grid.Column="4" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img3" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Border x:Name="pb4" Grid.Row="2" Grid.Column="0" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img4" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb5" Grid.Row="2" Grid.Column="2" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img5" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb6" Grid.Row="2" Grid.Column="4" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img6" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Border x:Name="pb7" Grid.Row="4" Grid.Column="0" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img7" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb8" Grid.Row="4" Grid.Column="2" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img8" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="pb9" Grid.Row="4" Grid.Column="4" Tag="NULL" Background="#252526" CornerRadius="10" Margin="8" Cursor="Hand" MouseLeftButtonDown="CellClicked">
                    <Image x:Name="img9" Source="/Resources/question-mark-96.png" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>
        </Border>

        <Button Style="{StaticResource SimpleHoverButton}" Grid.Row="3" Cursor="Hand" x:Name="btnRestartGame" Content="Restart Game" 
                Click="btnRestartGame_Click" Height="45" Background="#FF007ACC" 
                Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" 
                Margin="0,15,0,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>